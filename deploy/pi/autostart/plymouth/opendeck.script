# splash.png (audiodestrukt's wordmark, drawn by ../make_splash.py) centred
# at 60 % of the screen's width, on the image's own ground (#0d0d0d) so its
# edges do not show.
Window.SetBackgroundTopColor(13 / 255, 13 / 255, 13 / 255);
Window.SetBackgroundBottomColor(13 / 255, 13 / 255, 13 / 255);
logo = Image("splash.png");
w = Math.Int(Window.GetWidth() * 0.6);
h = Math.Int(logo.GetHeight() * w / logo.GetWidth());
logo = logo.Scale(w, h);
sprite = Sprite(logo);
sprite.SetX(Window.GetX() + (Window.GetWidth() - w) / 2);
sprite.SetY(Window.GetY() + (Window.GetHeight() - h) / 2);
