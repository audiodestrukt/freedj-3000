/target
Cargo.lock
*.mp3
# Exception: the bundled demo track shipped with the iOS app (an original
# production of Dan's — "amplificate", from produkshun/finished tracks; the
# source .flp lives in the archive). Tracked so CI bundles it; everything else
# stays ignored. Alphabetically it precedes techno.mp3, so bundle-track.sh picks
# THIS one, and a fresh CI checkout has only this one anyway.
!/amplificate.mp3

# Pioneer manual page extracts — copyrighted, local reference only.
# Regenerate with: tools/fetch-reference.sh
/reference/pioneer/

# Photos of our own units are tracked: reference/photos/

# Faceplate background image for --faceplate is NOT bundled (trade dress /
# copyright). Supply your own via OPENDECK_FACEPLATE_IMG or ~/Downloads; if you
# drop one in the repo under assets/faceplate/ it stays untracked.
/assets/faceplate/

third_party/**/target/

# Xcode state regenerated on every open/build — the .pbxproj is the source of
# truth, and the implicit workspace is derived from it.
xcuserdata/
project.xcworkspace/

# Generated CAD output (STL/preview renders) — rebuild with `make cad`
hardware/cad/build/
# Blender auto-save backups
*.blend1
