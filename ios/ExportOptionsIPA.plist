<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Same signing as ExportOptionsCI.plist, but writes the .ipa to disk
         (destination export) so CI can keep it as a build artifact.  It is
         App Store signed: it installs through TestFlight / the App Store (or
         re-uploads with Transporter), not by side-loading onto a device. -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>W527ZN3X52</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
